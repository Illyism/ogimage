# Database
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/ogimage?schema=public"

# Optional: For SSH tunnel to production database
# PROD_DATABASE_URL="postgres://user:pass@container-name:5432/db"

# S3 / Object Storage (Hetzner)
# S3 endpoint URL
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
# S3 region
S3_REGION="fsn1"
# S3 access key ID
S3_ACCESS_KEY_ID="your-access-key-id"
# S3 secret access key
S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3 bucket name
S3_BUCKET="ogimage"

# Application
# Public URL of your application (used for file URLs)
NEXT_PUBLIC_APP_URL="https://ogimage.org"


# Anthropic / Claude AI
# Anthropic API key for AI features
ANTHROPIC_API_KEY="your-anthropic-api-key"

# LemonSqueezy (Payment Processing)
# LemonSqueezy API key
LMSQUEEZY="your-lemonsqueezy-api-key"
# LemonSqueezy webhook secret
LMSQUEEZY_SECRET="your-lemonsqueezy-webhook-secret"
# LemonSqueezy environment (production/preview)
LMSQUEEZY_ENV="production"

# PostHog (Analytics)
# PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
# PostHog host URL
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# GitHub (for GitHub integration)
# GitHub personal access token
GITHUB_TOKEN="your-github-token"

# Resend (Email)
# Resend API key
RESEND_API_KEY="your-resend-api-key"

# Unsplash (for OG image templates)
# Unsplash API key
UNSPLASH_KEY="your-unsplash-key"
# Unsplash API secret
UNSPLASH_SECRET="your-unsplash-secret"

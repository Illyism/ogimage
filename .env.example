# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# S3 Storage (Hetzner Object Storage)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://hog.your-domain.com

# Resend (Email + audience for free-access signups)
RESEND_API_KEY=re_your_resend_api_key
RESEND_AUDIENCE_ID=your_resend_audience_id

# Anthropic (AI)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key

# GitHub (Optional - invites signups to the kit org)
# GITHUB_TOKEN=ghp_your_github_token

# App URL
NEXT_PUBLIC_APP_URL=https://ogimage.org

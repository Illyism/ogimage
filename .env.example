# PostHog Analytics (optional in local dev; skipped when empty)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://hog.your-domain.com

# Resend (gallery suggestions from /inspiration/submit; use a test-mode key in dev)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=contact@ogimage.org

# App URL (defaults to https://ogimage.org when unset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: screenshot templates (falls back to bundled sample screenshots when unset)
SCREENSHOT_API_URL=https://your-screenshot-service.example/screenshot
SCREENSHOT_API_KEY=your_screenshot_api_key

# Optional: city template (Unsplash access key; falls back to a bundled sample photo when unset)
UNSPLASH_KEY=your_unsplash_access_key

# Optional: design review in `bun run gallery:find`
ANTHROPIC_API_KEY=

# Optional: Cursor MCP servers in `.cursor/mcp.json` (set in Cursor Cloud Agent Secrets)
# COOLIFY_SELF_TOKEN=
# COOLIFY_CLOUD_TOKEN=
# PLAUSIBLE_API_KEY=
# DATAFAST_API_KEY=

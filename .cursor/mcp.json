{
  "mcpServers": {
    "Sentry": {
      "url": "https://mcp.sentry.dev/mcp/illyism/ogimage"
    },
    "coolify-self": {
      "command": "npx",
      "args": ["-y", "@masonator/coolify-mcp@3.9.0"],
      "env": {
        "COOLIFY_BASE_URL": "https://cooler.il.ly",
        "COOLIFY_ACCESS_TOKEN": "${env:COOLIFY_SELF_TOKEN}",
        "MCP_READONLY": "true"
      },
      "enabledTools": [
        "get_version",
        "get_mcp_version",
        "list_instances",
        "get_infrastructure_overview",
        "list_servers",
        "list_applications",
        "list_databases",
        "list_services",
        "list_deployments",
        "get_server",
        "get_application",
        "get_database",
        "get_service",
        "server_resources",
        "server_domains",
        "list_destinations",
        "diagnose_app",
        "coolify_url",
        "diagnose_server",
        "find_issues",
        "search_docs",
        "application_logs",
        "logs",
        "teams"
      ]
    },
    "coolify-cloud": {
      "url": "https://app.coolify.io/mcp",
      "headers": {
        "Authorization": "Bearer ${env:COOLIFY_CLOUD_TOKEN}"
      }
    },
    "plausible": {
      "command": "npx",
      "args": ["-y", "plausible-mcp"],
      "env": {
        "PLAUSIBLE_API_KEY": "${env:PLAUSIBLE_API_KEY}"
      }
    },
    "datafast": {
      "url": "https://datafa.st/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:DATAFAST_API_KEY}"
      }
    }
  }
}
